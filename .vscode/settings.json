{
  "java.project.resourceFilters": [
    "node_modules",
    ".expo",
    "dist"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.expo/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.expo": true,
    "**/dist": true
  },
  "css.lint.unknownAtRules": "ignore",
  "java.compile.nullAnalysis.mode": "automatic"
}