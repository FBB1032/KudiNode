{
  "expo": {
    "name": "KudiNode AI",
    "slug": "kudinode-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teamalafia.kudinode"
    },
    "android": {
      "package": "com.teamalafia.kudinode",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A1D7A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "eeeb1265-dbe7-41c2-8996-3454c76e3f59"
      }
    },
    "owner": "fahd320"
  }
}
