# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins (admin dashboard, Expo dev, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,exp://127.0.0.1:19000,https://kudinode.vercel.app/

# ── Supabase ────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# anon (public) key — used to verify user JWTs
SUPABASE_ANON_KEY=

# service role key — SERVER ONLY, never expose to clients.
# Bypasses RLS; used for privileged writes & signed URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names (must match schema.sql)
KYC_BUCKET=kyc-documents
LEDGER_BUCKET=ledger-images

# ── AI Integrations ─────────────────────────────────────
# Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
# REQUIRED for voice transfer parsing (fallback). Receipt scanning now uses OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter AI (free vision models for receipt scanning)
# Get a free key at https://openrouter.ai/keys (enable free models)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen-2.5-vl-7b-instruct:free

# Optional Groq API (for Llama models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: your faster-whisper HTTP service endpoint
FAST_WHISPER_URL=
FAST_WHISPER_API_KEY=
FAST_WHISPER_LANGUAGE_HINT=
