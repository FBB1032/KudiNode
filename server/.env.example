# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins (admin dashboard, Expo dev, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,exp://127.0.0.1:19000

# ── Supabase ────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# anon (public) key — used to verify user JWTs
SUPABASE_ANON_KEY=

# service role key — SERVER ONLY, never expose to clients.
# Bypasses RLS; used for privileged writes & signed URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names (must match schema.sql)
KYC_BUCKET=kyc-documents
LEDGER_BUCKET=ledger-images

# ── AI Integrations ─────────────────────────────────────
# Gemini key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: your faster-whisper HTTP service endpoint.
# If unset, backend will transcribe audio with Gemini directly.
FAST_WHISPER_URL=
FAST_WHISPER_API_KEY=

# Optional language hint (e.g. en, yo, ig, ha)
FAST_WHISPER_LANGUAGE_HINT=
